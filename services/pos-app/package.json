{
  "name": "pos-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild client/app.js --bundle --format=esm --platform=browser --outfile=build/app.js",
    "build:worker": "esbuild src/worker.ts --bundle --format=esm --platform=browser --conditions=workerd --external:cloudflare:workers --external:app.js --outfile=build/worker.js",
    "build": "pnpm build:client && pnpm build:worker",
    "dev": "pnpm build && workerd serve workerd.capnp --socket-addr http=*:${PORT:-3000}",
    "start": "workerd serve workerd.capnp --socket-addr http=*:${PORT:-3000}"
  },
  "dependencies": {
    "capnweb": "0.12.0"
  }
}
