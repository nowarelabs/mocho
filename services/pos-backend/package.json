{
  "name": "pos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.ts --bundle --format=esm --platform=browser --conditions=workerd --external:cloudflare:workers --loader:.sql=text --outfile=build/worker.js",
    "verify": "node --no-warnings test/verify-schema.ts",
    "dev": "vp run build && workerd serve workerd.capnp --socket-addr http=*:${PORT:-50050}",
    "start": "workerd serve workerd.capnp --socket-addr http=*:${PORT:-50050}"
  },
  "dependencies": {
    "capnweb": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
